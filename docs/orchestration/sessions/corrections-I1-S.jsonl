dialog(webview.OPEN_DIALOG, allow_multiple=False,\\n755|                                            file_types=(\\\"Programme (tesseract.exe)\\\", \\\"Tous les fichiers (*.*)\\\"))\\n756|        if not r:\\n757|            return {\\\"annule\\\": True}\\n758|        chemin = r[0] if isinstance(r, (list, tuple)) else r\\n759|        self._sauver_cfg(lambda c: c.update(ocr_exe=os.path.abspath(chemin)))\\n760|        self._ocr_memo = None\\n761|        return self.ocr_etat()\\n762|\\n763|    @_proteger(ACTION)\\n764|    def ocr_installer(self):\\n765|        \\\"\\\"\\\"Installe le moteur portable a la demande (I1, D6). Le clic sur « Installer » est l'accord explicite : aucun\\n766|        consentement `ocr` n'est exige, installer n'est pas extraire, et le consentement n'est pas donne par ce clic.\\n767|        Moteur deja detecte : l'etat complet, rien n'est telecharge. Succes : `ocr_etat()` (les deux pages ne se\\n768|        rafraichissent que sur une reponse qui porte `moteur`, ecart 238). Erreur : la phrase, telle quelle, ecrite\\n769|        aussi au journal. `{\\\"annule\\\": True}` est relaye. Pas d'arret branche : aucun bouton n'annule le telechargement.\\\"\\\"\\\"\\n770|        if self._ocr_moteur(self._cfg(), frais=True).get(\\\"present\\\"):\\n771|            return self.ocr_etat()\\n772|        r = ocr.installer_paquet()\\n773|        if r.get(\\\"annule\\\"):\\n774|            return {\\\"annule\\\": True}\\n775|        if not r.get(\\\"ok\\\"):\\n776|            phrase = r.get(\\\"erreur\\\") or _message(\\\"installation_echec\\\")\\n777|            self._ocr_journal(phrase)\\n778|            return {\\\"erreur\\\": phrase}\\n779|        self._ocr_memo = None\\n780|        etat = self.ocr_etat()\\n781|        self._ocr_journal(_message(\\\"installation_faite\\\"))\\n782|        return etat\\n783|\\n784|    def _ocr_exemple(self):\\n785|        \\\"\\\"\\\"Forme 2.7 d'un exemple : aucun scan, ou moteur absent. Le document de demonstration appartient a U3