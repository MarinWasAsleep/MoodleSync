{"type": "tool_result", "name": "read_file", "tool_call_id": "toolu_01LJTibnrEZXjyxaurChxjWL", "output": "{\"content\": \"370|\\n371|\\n372|# ---------------------------------------------------------------------------------------------\\n373|# Tache I1 : installation du moteur a la demande (paquet portable, contrat 3.1 et D6).\\n374|# ---------------------------------------------------------------------------------------------\\n375|DEPOT_MOTEUR = \\\"MarinWasAsleep/MoodleSync-moteur\\\"     # une release par version du moteur\\n376|NOM_PAQUET = \\\"MoodleSync-moteur.zip\\\"                  # le fichier de la release : tesseract et tessdata a la racine\\n377|# SHA-256 du fichier NOM_PAQUET, inscrit dans le code et jamais lu dans la reponse du serveur (decision de Maxence du\\n378|# 9 novembre 2026, meme confiance que maj.py). Vide tant que le paquet n'est pas publie : installer_paquet repond\\n379|# alors installation_indisponible, sans reseau ni decompression.\\n380|EMPREINTE_PAQUET = \\\"\\\"\\n381|TAILLE_MAX_PAQUET = 300 * 1024 * 1024                 # le paquet annonce fait environ 65 Mo (plan 3.3)\\n382|TAILLE_MAX_DECOMPRESSE = 1024 * 1024 * 1024\\n383|BLOC_TELECHARGEMENT = 256 * 1024\\n384|_VERROU_PAQUET = threading.Lock()\\n385|\\n386|\\n387|def _horloge():\\n388|    return time.monotonic()\\n389|\\n390|\\n391|def _parties_sures(nom):\\n392|    \\\"\\\"\\\"Composants d'un nom d'entree d'archive, ou None si le nom sort du dossier cible : chemin absolu ou de lecteur,\\n393|    `..`, octet nul, composant a deux-points (flux Windows). Les antislashs valent des separateurs : un zip fait sous\\n394|    Windows peut les garder tels quels.\\\"\\\"\\\"\\n395|    texte = str(nom or \\\"\\\").replace(\\\"\\\\\\\\\\\", \\\"/\\\")\\n396|    if not texte or \\\"\\\\x00\\\" in texte or texte.startswith(\\\"/\\\"):\\n397|        return None\\n398|    parties = [p for p in texte.split(\\\"/\\\") if p not in (\\\"\\\", \\\".\\\")]\\n399|    if not parties or any(p == \\\"..\\\" or \\\":\\\" in p for p in parties):\\n400|        return None\\n401|    return parties\\n402|\\n403|\\n404|def _supprimer(chemin):\\n405|    try:\\n406|        if os.path.isdir(chemin) and not os.path.islink(chemin):\\n407|            shutil.rmtree(chemin)\\n408|        elif os.path.lexists(chemin):\\n409|            os.remove(chemin)\\n410|    except OSError:\\n411|        pass\\n412|\\n413|\\n414|def _telecharger_paquet(url, taille, destination, progres, arreter):\\n415|    \\\"\\\"\\\"Telecharge `url` dans `destination` en flux. Rend (empreinte SHA-256 hexadecimale, octets) ou None si l'arret\\n416|    est demande. `progres(recu, total)` est appele au plus quatre fois par seconde.\\\"\\\"\\\"\\n417|    from . import maj\\n418|    h, recu, dernier = hashlib.sha256(), 0, None\\n419|    with maj.ouvrir(url, timeout=60) as r, open(destination, \\\"wb\\\") as f:\\n420|        while True:\\n421|            if arreter and arreter():\\n422|                return None\\n423|            bloc = r.read(BLOC_TELECHARGEMENT)\\n424|            if not bloc:\\n425|                break\\n426|            recu += len(bloc)\\n427|            if recu > TAILLE_MAX_PAQUET:\\n428|                raise ErreurOcr(\\\"paquet_invalide\\\")\\n429|            h.update(bloc)\\n430|            f.write(bloc)\\n431|            maintenant = _horloge()\\n432|            if progres and (dernier is None or maintenant - dernier >= 0.25):\\n433|                dernier = maintenant\\n434|                progres(recu, taille)\\n435|    return h.hexdigest(), recu\\n436|\\n437|\\n438|def _decompresser_paquet(archive, dossier, arreter):\\n439|    \\\"\\\"\\\"Decompresse `archive` dans `dossier` (neuf). Tout est verifie avant la premiere ecriture : un nom qui sort du\\n440|    dossier, un lien symbolique, une taille demesuree, l'absence du moteur a la racine. Rend False si l'arret est\\n441|    demande. Leve ErreurOcr(paquet_invalide) pour une archive inacceptable.\\\"\\\"\\\"\\n442|    try:\\n443|        z = zipfile.ZipFile(archive)\\n444|    except (zipfile.BadZipFile, OSError):\\n445|        raise ErreurOcr(\\\"paquet_invalide\\\")\\n446|    with z:\\n447|        membres, total = [], 0\\n448|        for info in z.infolist():\\n449|            parties = _parties_sures(info.filename)\\n450|            if parties is None:\\n451|                raise ErreurOcr(\\\"paquet_invalide\\\")\\n452|            if stat.S_ISLNK(info.external_attr >> 16):\\n453|                raise ErreurOcr(\\\"paquet_invalide\\\")\\n454|            cible = os.path.join(dossier, *parties)\\n455|            if os.path.commonpath([os.path.realpath(dossier), os.path.realpath(cible)]) != os.path.realpath(dossier):\\n456|                raise ErreurOcr(\\\"paquet_invalide\\\")\\n457|            total += info.file_size\\n458|            if total > TAILLE_MAX_DECOMPRESSE:\\n459|                raise ErreurOcr(\\\"paquet_invalide\\\")\\n460|            membres.append((info, cible, info.is_dir() or info.filename.replace(\\\"\\\\\\\\\\\", \\\"/\\\").endswith(\\\"/\\\")))\\n461|        if not any(not est_dossier and os.path.dirname(os.path.relpath(c, dossier)) == \\\"\\\" and\\n462|                   os.path.basename(c) == NOM_EXE_PAQUET for _, c, est_dossier in membres):\\n463|            raise ErreurOcr(\\\"paquet_invalide\\\")\\n464|        for info, cible, est...", "duration_ms": 57, "is_error": false, "timestamp": 1794260020264}
